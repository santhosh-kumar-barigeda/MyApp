    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-native": "0.86.2",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-keyboard-controller": "^1.22.2",
